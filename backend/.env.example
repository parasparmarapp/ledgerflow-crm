PORT=5100
DATABASE_URL="file:./dev.db"
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development

# Third-Party Integrations & API Credentials (Required for External Services)
# Email Delivery Service (email)
EMAIL_PROVIDER_API_KEY="provider-api-key"
EMAIL_FROM_ADDRESS="billing@example.com"
# SMS Provider Integration (Arkesel - https://developers.arkesel.com)
ARKESEL_API_KEY="replace_with_arkesel_api_key"
# Sender ID: max 11 chars, must be approved in the Arkesel dashboard
ARKESEL_SENDER_ID="LedgerFlow"
ARKESEL_BASE_URL="https://sms.arkesel.com/api/v2"
SMS_ENABLED="true"
# true = Arkesel sandbox (no credits charged, SMS not delivered)
SMS_SANDBOX="true"
SMS_DEFAULT_COUNTRY_CODE="233"
# Optional: public URL for Arkesel delivery reports
SMS_CALLBACK_URL=""
